use App\Controllers\AuthController;
use App\Controllers\DashboardController;

// @veil-routes — generated by slenix/veil (do not remove this comment)

// ── Guest Routes ────────────────────────────────────────────────────────────
// These routes are only accessible to unauthenticated users.
// The 'guest' middleware redirects logged-in users to the dashboard.
Router::group(['middleware' => ['guest']], function () {

    // Registration: display form and handle submission.
    Router::get('/register', [AuthController::class, 'showRegister'])->name('show.register');
    Router::post('/sign-up/user', [AuthController::class, 'store'])->name('register');

    // Login: display form and handle submission.
    Router::get('/login', [AuthController::class, 'index'])->name('show.login');
    Router::post('/sign-in/user', [AuthController::class, 'login'])->name('login');
});

// ── Authenticated Routes ────────────────────────────────────────────────────
// These routes require an active session.
// The 'auth' middleware redirects unauthenticated users to the login page.
Router::group(['middleware' => ['auth']], function () {

    // ── Dashboard ──────────────────────────────────────────────────────────
    // Main dashboard and settings views, served by DashboardController.
    Router::get('/dashboard', [DashboardController::class, 'index'])->name('dashboard.show');
    Router::get('/settings', [DashboardController::class, 'settings'])->name('settings.show');

    // ── Profile & Password Updates ─────────────────────────────────────────
    // Both endpoints use POST for broad form compatibility.
    // Forms should send @method('PUT') as a hidden field for semantic clarity.
    Router::post('/updated/user', [AuthController::class, 'update'])->name('update.user');
    Router::post('/updated/password', [AuthController::class, 'updatedPassword'])->name('update.password');

    // ── Account Deletion ───────────────────────────────────────────────────
    // Requires the user to type "delete" as explicit confirmation.
    // On success, the session is terminated and the user is redirected to login.
    Router::post('/delete/user', [AuthController::class, 'delete'])->name('delete.user');

    // ── Session ────────────────────────────────────────────────────────────
    // Terminates the authenticated session and redirects to the login page.
    Router::get('/logout', [AuthController::class, 'logout'])->name('logout');
});

// @end-veil-routes