<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@yield('title', 'Slenix')</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
                         Oxygen, Ubuntu, sans-serif;
            background: #f1f1f0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #1a1a1a;
        }

        .logo {
            margin-bottom: 1.5rem;
        }

        .logo svg {
            width: 48px;
            height: 48px;
            opacity: .85;
        }

        .card {
            background: #fff;
            border-radius: 12px;
            padding: 2rem 2.5rem;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.04);
        }

        .form-group {
            margin-bottom: 1.1rem;
        }

        label {
            display: block;
            font-size: .85rem;
            font-weight: 500;
            margin-bottom: .4rem;
            color: #374151;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: .55rem .8rem;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            font-size: .95rem;
            color: #111;
            background: #fff;
            transition: border-color .15s, box-shadow .15s;
            outline: none;
        }

        input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.12);
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: .5rem;
            margin-bottom: 1.25rem;
            font-size: .875rem;
            color: #555;
        }

        .checkbox-group input[type="checkbox"] {
            width: 15px;
            height: 15px;
            accent-color: #6366f1;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: .55rem 1.25rem;
            border-radius: 7px;
            font-size: .9rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: background .15s, opacity .15s;
            text-decoration: none;
        }

        .btn-primary {
            background: #1a1a1a;
            color: #fff;
        }

        .btn-primary:hover { background: #333; }

        .btn-danger {
            background: #dc2626;
            color: #fff;
        }

        .btn-danger:hover { background: #b91c1c; }

        .btn-full { width: 100%; }

        .form-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 1.5rem;
        }

        .form-footer a,
        .text-link {
            font-size: .85rem;
            color: #6b7280;
            text-decoration: none;
        }

        .form-footer a:hover,
        .text-link:hover { color: #111; }

        .alert {
            padding: .75rem 1rem;
            border-radius: 7px;
            font-size: .875rem;
            margin-bottom: 1.25rem;
        }

        .alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #dc2626;
        }

        .alert-success {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #16a34a;
        }

        /* Dashboard layout */
        .app-layout {
            display: flex;
            min-height: 100vh;
            width: 100%;
            background: #f9f9f8;
        }

        .sidebar {
            width: 220px;
            background: #fff;
            border-right: 1px solid #ebebeb;
            display: flex;
            flex-direction: column;
            padding: 1.5rem 1rem;
            gap: .25rem;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: .6rem;
            font-weight: 700;
            font-size: 1rem;
            padding: .5rem .75rem;
            margin-bottom: .75rem;
            color: #111;
        }

        .sidebar-brand svg {
            width: 28px;
            height: 28px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: .6rem;
            padding: .5rem .75rem;
            border-radius: 7px;
            font-size: .9rem;
            color: #444;
            text-decoration: none;
            transition: background .12s;
        }

        .nav-item:hover,
        .nav-item.active {
            background: #f3f3f2;
            color: #111;
        }

        .main {
            flex: 1;
            padding: 2.5rem 3rem;
        }

        .main-header {
            margin-bottom: 2rem;
            border-bottom: 1px solid #ebebeb;
            padding-bottom: 1.25rem;
        }

        .main-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111;
        }

        .main-header p {
            font-size: .9rem;
            color: #6b7280;
            margin-top: .25rem;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: .75rem;
            border-top: 1px solid #ebebeb;
            display: flex;
            align-items: center;
            gap: .6rem;
            font-size: .875rem;
            color: #444;
        }

        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #1a1a1a;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .75rem;
            font-weight: 700;
            flex-shrink: 0;
        }
    </style>
    @stack('styles')
</head>
<body>
    @yield('content')
    @stack('scripts')
</body>
</html>