<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@yield('title', 'Slenix')</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Geist', 'system-ui', 'sans-serif'],
                        mono: ['Geist Mono', 'monospace'],
                    },
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Geist', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        input:-webkit-autofill { -webkit-box-shadow: 0 0 0 30px white inset !important; }
        .dark input:-webkit-autofill { -webkit-box-shadow: 0 0 0 30px #1c1c1a inset !important; -webkit-text-fill-color: #ececec !important; }
        * { box-sizing: border-box; }
    </style>
    @stack('styles')
</head>
<body class="bg-[#f5f4f1] dark:bg-[#111110] text-[#0f0f0f] dark:text-[#ececec] min-h-screen">

    @yield('content')

    <script>
    // Theme
    (function() {
        const saved = localStorage.getItem('veil-theme') || 'light';
        if (saved === 'dark') {
            document.documentElement.classList.add('dark');
        }
        window.setTheme = function(t) {
            localStorage.setItem('veil-theme', t);
            document.documentElement.classList.toggle('dark', t === 'dark');
            document.querySelectorAll('.theme-btn').forEach(b => {
                b.classList.toggle('bg-white', b.dataset.t === t && t === 'light');
                b.classList.toggle('dark:bg-[#2a2a28]', b.dataset.t === t);
                b.classList.toggle('text-[#0f0f0f]', b.dataset.t === t);
                b.classList.toggle('dark:text-[#ececec]', b.dataset.t === t);
            });
        };
        window.setTheme(saved);
    })();

    // Dropdown
    document.addEventListener('click', function(e) {
        const pill = e.target.closest('.user-pill');
        const dd   = document.getElementById('user-dd');
        if (!dd) return;
        if (pill) {
            dd.classList.toggle('hidden');
        } else if (!e.target.closest('#user-dd')) {
            dd.classList.add('hidden');
        }
    });
    </script>
    @stack('scripts')
</body>
</html>