@push('scripts')
<script>
    /**
     * @fileoverview Settings page — tab persistence, password utilities,
     * font-size switcher, and delete account modal.
     *
     * Tab resolution priority (highest → lowest):
     *   1. ?tab= URL query param  (used by sidebar "Profile" / "Settings" links)
     *   2. localStorage 'settings-active-tab'  (set by form onsubmit)
     *   3. Default: 'profile'
     *
     * localStorage key is cleared immediately after reading so it only
     * affects the single reload triggered by a form submission.
     */

    // ── Tab Initialisation ────────────────────────────────────────────────

    (function initSettingsTab() {
        const params    = new URLSearchParams(window.location.search);
        const urlTab    = params.get('tab');
        const lsTab     = localStorage.getItem('settings-active-tab');
        const activeTab = urlTab || lsTab || 'profile';

        // Consume the stored tab so future visits start on 'profile'.
        localStorage.removeItem('settings-active-tab');

        activateTab(activeTab);
    })();

    /**
     * Activates a settings tab by its ID suffix.
     *
     * @param {string} tabId - e.g. 'profile', 'password', 'appearance'
     * @returns {void}
     */
    function activateTab(tabId) {
        document.querySelectorAll('.settings-nav-item').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.settings-tab').forEach(el => el.classList.remove('active-tab'));

        const navItem = document.querySelector(`.settings-nav-item[data-tab="${tabId}"]`);
        if (navItem) navItem.classList.add('active');

        const panel = document.getElementById('tab-' + tabId);
        if (panel) panel.classList.add('active-tab');
    }

    /**
     * Switches the visible settings tab on user click.
     * Overrides the global switchTab() from the app shell layout.
     *
     * @param {string} tabId - Target tab identifier.
     * @param {Event}  event - Click event from the nav anchor.
     * @returns {void}
     */
    function switchTab(tabId, event) {
        if (event) event.preventDefault();
        activateTab(tabId);
    }

    // ── Password Utilities ────────────────────────────────────────────────

    /**
     * Toggles a password input between visible text and masked dots.
     *
     * @param {string}      inputId - ID of the target <input>.
     * @param {HTMLElement} icon    - The eye <i> element to update.
     * @returns {void}
     */
    function togglePwd(inputId, icon) {
        const input  = document.getElementById(inputId);
        const hidden = input.type === 'password';
        input.type    = hidden ? 'text' : 'password';
        icon.className = hidden ? 'bx bx-hide pwd-eye' : 'bx bx-show pwd-eye';
    }

    /**
     * Updates the password strength bar and label.
     *
     * Scores one point per rule met:
     *   1. Length >= 8
     *   2. Contains an uppercase letter
     *   3. Contains a digit
     *   4. Contains a special character
     *
     * @param {string} value - Current password field value.
     * @returns {void}
     */
    function updateStrength(value) {
        const fill  = document.getElementById('pwd-strength-fill');
        const label = document.getElementById('pwd-strength-label');
        if (!fill || !label) return;

        if (!value) {
            fill.style.width  = '0%';
            fill.className    = 'pwd-strength-fill';
            label.textContent = '';
            return;
        }

        let score = 0;
        if (value.length >= 8)           score++;
        if (/[A-Z]/.test(value))         score++;
        if (/[0-9]/.test(value))         score++;
        if (/[^A-Za-z0-9]/.test(value))  score++;

        const levels = [
            { pct: '25%',  cls: 'weak',   text: 'Weak'   },
            { pct: '50%',  cls: 'fair',   text: 'Fair'   },
            { pct: '75%',  cls: 'good',   text: 'Good'   },
            { pct: '100%', cls: 'strong', text: 'Strong' },
        ];

        const level       = levels[Math.max(0, score - 1)];
        fill.style.width  = level.pct;
        fill.className    = `pwd-strength-fill ${level.cls}`;
        label.textContent = level.text;
        label.className   = `pwd-strength-label ${level.cls}`;
    }

    // ── Font Size ─────────────────────────────────────────────────────────

    /**
     * Applies and persists a body font-size preference.
     *
     * @param {'small'|'medium'|'large'} size
     * @returns {void}
     */
    function setFontSize(size) {
        const map = { small: '13px', medium: '14px', large: '15px' };
        document.body.style.fontSize = map[size] || '14px';
        localStorage.setItem('slenix-font-size', size);

        document.querySelectorAll('.font-size-btn').forEach(btn => {
            btn.classList.toggle('active', btn.textContent.toLowerCase() === size);
        });
    }

    (function initFontSize() {
        const saved = localStorage.getItem('slenix-font-size') || 'medium';
        setFontSize(saved);
    })();

    // ── Delete Modal ──────────────────────────────────────────────────────

    /** Opens the account-deletion confirmation modal. @returns {void} */
    function openDeleteModal() {
        document.getElementById('deleteModal').classList.add('show');
        document.getElementById('delete-confirm-input').value = '';
        document.getElementById('confirm-delete-btn').disabled = true;
    }

    /** Closes the account-deletion confirmation modal. @returns {void} */
    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.remove('show');
    }

    /**
     * Enables the confirm-delete button only when the user types "delete".
     *
     * @param {string} value - Current value of the confirmation input.
     * @returns {void}
     */
    function toggleDeleteBtn(value) {
        document.getElementById('confirm-delete-btn').disabled = value.trim() !== 'delete';
    }
</script>
@endpush