        {{-- Password (with show/hide toggle) ───────────────────────────── --}}
        <div class="form-group" style="position: relative;">
            <label for="password" class="form-label">Password</label>
            <input
                type="password"
                id="password"
                name="password"
                class="form-input"
                placeholder="••••••••"
