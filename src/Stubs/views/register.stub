{{-- ── REGISTRATION FORM ────────────────────────────────────────────────── --}}
{{--
    POST /register → AuthController@store
    Validated by RegisterRequest (name, email, password + confirmation rules).
    On success: creates the user, logs them in, redirects to /dashboard.
    On failure: redirects back with a flash error; @old() restores field values.
--}}
<form action="{{ route('register') }}" method="POST" autocomplete="off">

    {{-- CSRF protection --}}
    @csrf

    {{-- Full Name ────────────────────────────────────────────────────────── --}}
    <div class="form-group">
        <label for="name" class="form-label">Full name</label>
        <input
            type="text"
            id="name"
            name="name"
            value="@old('name')"
            placeholder="John Smith"
            class="form-input @error_class('name', 'form-input--error')"
        />
        @error('name')
            <span class="form-error">{{ $message }}</span>
        @enderror
    </div>

    {{-- Email ───────────────────────────────────────────────────────────── --}}
    <div class="form-group">
        <label for="email" class="form-label">Email</label>
        <input
            type="text"
            id="email"
            name="email"
            value="@old('email')"
            placeholder="name@example.com"
            class="form-input @error_class('email', 'form-input--error')"
        />
        @error('email')
            <span class="form-error">{{ $message }}</span>
        @enderror
    </div>

    {{-- Password ─────────────────────────────────────────────────────────
        The eye icon calls togglePasswordVisibility() (defined in guest.luna.php)
        to swap the input between type="password" and type="text".
    --}}
    <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <div class="input-password-wrap">
            <input
                type="password"
                id="password"
                name="password"
                placeholder="••••••••"
                class="form-input @error_class('password', 'form-input--error')"
            />
            <i class="bx bx-show pwd-eye"
               id="password-toggle"
               onclick="togglePasswordVisibility('password', 'password-toggle')">
            </i>
        </div>
        @error('password')
            <span class="form-error">{{ $message }}</span>
        @enderror
    </div>

    {{-- Confirm Password ─────────────────────────────────────────────────
        Must match the password field — enforced by RegisterRequest's
        'confirmed' rule on the server side.
    --}}
    <div class="form-group">
        <label for="password_confirmation" class="form-label">Confirm password</label>
        <div class="input-password-wrap">
            <input
                type="password"
                id="password_confirmation"
                name="password_confirmation"
                placeholder="••••••••"
                class="form-input @error_class('password_confirmation', 'form-input--error')"
            />
            <i class="bx bx-show pwd-eye"
               id="password-toggle-confirm"
               onclick="togglePasswordVisibility('password_confirmation', 'password-toggle-confirm')">
            </i>
        </div>
        @error('password_confirmation')
            <span class="form-error">{{ $message }}</span>
        @enderror
    </div>

    {{-- ACTIONS ──────────────────────────────────────────────────────────── --}}
    <div class="card-footer">
        <a href="{{ route('login') }}" class="link-sub">Already have an account?</a>
        <button type="submit" class="btn">Create account &rarr;</button>
    </div>

</form>

@endsection