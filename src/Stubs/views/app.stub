                <button class="user-pill" onclick="toggleDropdown(event)" aria-haspopup="true" aria-expanded="false">
                    <div class="user-avatar">
                        {!! avatar(auth()->user()->name . '' . auth()->user()->email, 90, '#0f0f0f') !!}
                    </div>
                    <div class="user-info">
                        <span class="user-name">{{ auth()->user()->name }}</span>
                        <span class="user-email">{{ auth()->user()->email }}</span>
                    </div>
                    <div class="user-chevrons">
                        <i class='bx bx-chevron-up'></i>
                        <i class='bx bx-chevron-down'></i>
                    </div>
                </button>
            </div>
        </aside>
        {{-- ── END SIDEBAR ── --}}

        {{-- ── MAIN CONTENT ─────────────────────────────────────────────────
            Child views inject their markup here via @section('content').
            Do not add extra wrappers inside child views unless strictly needed.
        ──────────────────────────────────────────────────────────────────── --}}
        <main class="main-content">
            @yield('content')
        </main>

    </div>{{-- /.app-layout --}}

    {{-- ─────────────────────────────────────────────────────────────────
        CORE SCRIPTS
        Handles: theme persistence, sidebar toggle, dropdown behaviour,
        settings tab switching, and other shared UI interactions.
    ───────────────────────────────────────────────────────────────────── --}}
    <script>
        /**
         * @fileoverview Slenix Veil — Core Frontend Logic
         *
         * Covers:
         *   - Theme initialisation and persistence via localStorage
         *   - User dropdown open/close with outside-click dismissal
         *   - Mobile sidebar drawer toggle with overlay
         *   - Settings page tab switching
         *
         * This script is inlined in the shell layout so it executes before
         * any deferred or async resources load, preventing a flash of the
         * wrong theme on page load.
         */

        // ── Theme ──────────────────────────────────────────────────────────

        /**
         * Initialises the application theme from localStorage.
         *
         * Reads the persisted theme preference and applies it to the
         * <html> element's data-theme attribute. Must run synchronously
         * before the DOM is painted to prevent a flash of the wrong theme.
         *
         * @returns {void}
         */
        function initTheme() {
            const savedTheme = localStorage.getItem('slenix-theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
        }

        // Execute immediately — do not defer.
        initTheme();

        /**
         * Synchronises theme-related UI controls (buttons, preview cards)
         * once the DOM is fully loaded and all elements are available.
         */
        document.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('slenix-theme') || 'light';
            updateThemeToggles(savedTheme);
        });

        /**
         * Switches the application theme and persists the selection.
         *
         * Updates the <html> data-theme attribute, saves the preference to
         * localStorage, and refreshes all toggle controls to reflect the
         * new state.
         *
         * @param {string} theme - Theme identifier: 'light' or 'dark'.
         * @returns {void}
         */
        function setTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('slenix-theme', theme);
            updateThemeToggles(theme);
        }

        /**
         * Updates the visual active state of theme toggle buttons and
         * appearance preview cards to reflect the currently active theme.
         *
         * Safe to call even when the controls do not exist on the page
         * (e.g. outside the Settings view).
         *
         * @param {string} theme - The currently active theme: 'light' or 'dark'.
         * @returns {void}
         */
        function updateThemeToggles(theme) {
            const lightBtn = document.getElementById('theme-light-btn');
            const darkBtn  = document.getElementById('theme-dark-btn');

            if (!lightBtn || !darkBtn) return;

            const isDark = theme === 'dark';
            darkBtn.classList.toggle('active', isDark);
            lightBtn.classList.toggle('active', !isDark);

            // Appearance preview cards (present only on the Settings page).
            const cardLight = document.getElementById('card-light');
            const cardDark  = document.getElementById('card-dark');

            if (cardLight && cardDark) {
                cardDark.classList.toggle('active', isDark);
                cardLight.classList.toggle('active', !isDark);
            }
        }

        // ── Dropdown ───────────────────────────────────────────────────────

        /**
         * Toggles the user account dropdown menu open or closed.
         *
         * Stops the click event from propagating to the document-level
         * listener that would immediately close the dropdown again.
         *
         * @param {MouseEvent} e - The click event from the pill button.
         * @returns {void}
         */
        function toggleDropdown(e) {
            e.stopPropagation();

            const dropdown = document.getElementById('userDropdown');
            const pill     = e.currentTarget;

            if (!dropdown) return;

            const isOpen = dropdown.classList.toggle('show');

            // Sync aria-expanded on the trigger button for accessibility.
            if (pill) {
                pill.setAttribute('aria-expanded', String(isOpen));
            }
        }

        /**
         * Closes the dropdown when the user clicks anywhere outside the
         * user-pill container.
         */
        document.addEventListener('click', (e) => {
            const dropdown  = document.getElementById('userDropdown');
            const container = document.getElementById('userPillContainer');

            if (dropdown && dropdown.classList.contains('show') && !container.contains(e.target)) {
                dropdown.classList.remove('show');

                // Reset aria-expanded on the pill button.
                const pill = container.querySelector('.user-pill');
                if (pill) pill.setAttribute('aria-expanded', 'false');
            }
        });

        // ── Sidebar ────────────────────────────────────────────────────────

        /**
         * Toggles the off-canvas sidebar drawer on mobile viewports.
         *
         * Adds/removes the .show class from both the sidebar and the
         * semi-transparent overlay behind it. The overlay's onclick also
         * calls this function, enabling tap-to-close behaviour.
         *
         * @returns {void}
         */
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('mobile-overlay');

            if (sidebar && overlay) {
                sidebar.classList.toggle('show');
                overlay.classList.toggle('show');
            }
        }

        // ── Settings Tabs ──────────────────────────────────────────────────

        /**
         * Switches the visible tab in the Settings interface.
         *
         * Deactivates all .settings-nav-item elements and .settings-tab
         * content panels, then activates the one matching tabId.
         *
         * @param {string}      tabId - ID suffix of the target tab panel
         *                             (rendered as `tab-${tabId}` in the DOM).
         * @param {Event|null}  event - The originating click event; used to
         *                             mark the clicked nav item as active.
         *                             Pass null if calling programmatically.
         * @returns {void}
         */
        function switchTab(tabId, event) {
            if (event) event.preventDefault();

            // Deactivate all nav items, then activate the clicked one.
            document.querySelectorAll('.settings-nav-item').forEach(el => el.classList.remove('active'));
            if (event && event.currentTarget) {
                event.currentTarget.classList.add('active');
            }

            // Hide all tab panels, then reveal the target.
            document.querySelectorAll('.settings-tab').forEach(el => el.classList.remove('active-tab'));
            const targetTab = document.getElementById('tab-' + tabId);
            if (targetTab) {
                targetTab.classList.add('active-tab');
            }
        }
    </script>

    {{-- Per-page scripts injected via @push('scripts') in child views --}}
    @stack('scripts')

</body>
</html>