<body class="fi-body">
    <div class="fi-layout">

        {{-- ── SIDEBAR ──────────────────────────────────────────────────── --}}
        <aside class="fi-sidebar" id="sidebar">

            {{-- Brand / Logo --}}
            <header class="fi-sidebar-header">
                <a href="{{ route('dashboard.show') ?? '#' }}" class="fi-logo">
                    <img src="{{ asset('logo.png') }}" alt="Slenix Veil" width="35" height="35">
                    <span class="fi-logo-text">Slenix Veil</span>
                </a>
            </header>

            {{-- Primary navigation links --}}
            <nav class="fi-sidebar-nav">
                <ul class="fi-nav-list">
                    <li class="fi-nav-item">
                        <a href="{{ route('dashboard.show') ?? '#' }}"
                           class="fi-nav-link {{ is_active('/dashboard') }}">
                            <i class='bx bx-home fi-nav-icon'></i>
                            <span class="fi-nav-label">Dashboard</span>
                        </a>
                    </li>
                </ul>
            </nav>

        </aside>
        {{-- ── END SIDEBAR ──────────────────────────────────────────────── --}}

        {{-- ── MAIN WRAPPER ───────────────────────────────────────────────── --}}
        <div class="fi-main-wrapper">

            {{-- ── TOPBAR ──────────────────────────────────────────────────── --}}
            <header class="fi-topbar">

                {{-- Mobile: hamburger menu trigger --}}
                <div class="fi-topbar-left">
                    <button class="fi-mobile-menu-btn" onclick="toggleSidebar()">
                        <i class='bx bx-menu'></i>
                    </button>
                </div>

                {{-- User menu pill (avatar + name + dropdown) --}}
                <div class="fi-topbar-right">
                    <div class="fi-user-menu" id="userPillContainer">

                        <button class="fi-user-button"
                                onclick="toggleDropdown(event)"
                                aria-expanded="false">
                            <div class="fi-avatar">
                                {{ substr(auth()->user()->name ?? 'A', 0, 1) }}
                            </div>
                            <span class="fi-user-name">
                                {{ auth()->user()->name ?? 'admin' }}
                            </span>
                        </button>

                        {{-- Dropdown: theme switcher + sign out --}}
                        <div class="fi-dropdown" id="userDropdown">

                            <div class="fi-dropdown-header">
                                <span class="fi-dropdown-name">
                                    {{ auth()->user()->name ?? 'admin' }}
                                </span>
                            </div>

                            <div class="fi-dropdown-divider"></div>

                            {{-- Light / Dark theme toggle --}}
                            <div class="fi-dropdown-appearance">
                                <span class="fi-dropdown-label">Toggle system theme</span>
                                <div class="fi-theme-toggles">
                                    <button class="fi-theme-btn" id="theme-light-btn" onclick="setTheme('light')">
                                        <i class='bx bx-sun'></i>
                                    </button>
                                    <button class="fi-theme-btn" id="theme-dark-btn" onclick="setTheme('dark')">
                                        <i class='bx bx-moon'></i>
                                    </button>
                                </div>
                            </div>

                            <div class="fi-dropdown-divider"></div>

                            {{-- Logout --}}
                            <form action="{{ route('logout') ?? '#' }}" method="GET" style="margin:0;">
                                <button type="submit" class="fi-dropdown-item">
                                    <i class='bx bx-log-out'></i> Sign out
                                </button>
                            </form>

                        </div>
                        {{-- END .fi-dropdown --}}

                    </div>
                </div>

            </header>
            {{-- ── END TOPBAR ───────────────────────────────────────────────── --}}

            {{-- ── PAGE CONTENT ────────────────────────────────────────────── --}}
            <main class="fi-main">
                <div class="fi-main-content">
                    @yield('content')
                </div>
            </main>
            {{-- ── END PAGE CONTENT ─────────────────────────────────────────── --}}

        </div>
        {{-- ── END MAIN WRAPPER ────────────────────────────────────────────── --}}

    </div>

    {{-- Mobile overlay — closes sidebar when tapped outside --}}
    <div class="fi-mobile-overlay" id="mobile-overlay" onclick="toggleSidebar()"></div>

    <script>
        /**
         * Reads the saved theme from localStorage and applies it to <html>
         * before the page renders to avoid a flash of unstyled content.
         */
        function initTheme() {
            const savedTheme = localStorage.getItem('slenix-theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
        }

        initTheme();

        /**
         * Once the DOM is ready, sync the active state of the theme toggle buttons.
         */
        document.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('slenix-theme') || 'light';
            updateThemeToggles(savedTheme);
        });

        /**
         * Apply a theme and persist the choice to localStorage.
         *
         * @param {'light'|'dark'} theme
         */
        function setTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('slenix-theme', theme);
            updateThemeToggles(theme);
        }

        /**
         * Mark the correct theme button as active based on the current theme.
         *
         * @param {'light'|'dark'} theme
         */
        function updateThemeToggles(theme) {
            const lightBtn = document.getElementById('theme-light-btn');
            const darkBtn  = document.getElementById('theme-dark-btn');

            if (!lightBtn || !darkBtn) return;

            const isDark = theme === 'dark';
            darkBtn.classList.toggle('active', isDark);
            lightBtn.classList.toggle('active', !isDark);
        }

        /**
         * Toggle the user dropdown open/closed.
         * Stops propagation so the document click handler doesn't close it immediately.
         *
         * @param {MouseEvent} e
         */
        function toggleDropdown(e) {
            e.preventDefault();
            e.stopPropagation();

            const dropdown = document.getElementById('userDropdown');
            const pill     = e.currentTarget;

            if (!dropdown) return;

            const isOpen = dropdown.classList.toggle('show');
            if (pill) pill.setAttribute('aria-expanded', String(isOpen));
        }

        /**
         * Close the dropdown when the user clicks anywhere outside the user menu.
         */
        document.addEventListener('click', (e) => {
            const dropdown  = document.getElementById('userDropdown');
            const container = document.getElementById('userPillContainer');

            if (dropdown?.classList.contains('show') && !container.contains(e.target)) {
                dropdown.classList.remove('show');
                const pill = container.querySelector('.fi-user-button');
                if (pill) pill.setAttribute('aria-expanded', 'false');
            }
        });

        /**
         * Toggle the sidebar and its backdrop overlay on mobile.
         */
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('mobile-overlay');

            sidebar?.classList.toggle('show');
            overlay?.classList.toggle('show');
        }
    </script>

    {{-- Per-page scripts injected by child views --}}
    @stack('scripts')

</body>
</html>