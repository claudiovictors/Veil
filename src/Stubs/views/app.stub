{{--
|--------------------------------------------------------------------------
| layouts/app.blade.php — Veil Application Shell Layout
|--------------------------------------------------------------------------
|
| Root layout for all authenticated pages. Renders the sidebar navigation,
| mobile header, and main content area. Child views extend this layout via:
|
|   @extends('layouts.app')
|
| Available sections
| ──────────────────
|   @section('title')    — overrides the <title> tag (default: 'Slenix - Veil')
|   @section('content')  — injected into <main class="main-content">
|
| Available stacks
| ──────────────────
|   @push('styles')      — appended inside <head> before </head>
|   @push('scripts')     — appended before </body>
|
--}}
<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{-- Page title — child views should override this section --}}
    <title>@yield('title', 'Slenix - Veil')</title>

    {{-- Google Fonts: Geist (sans) + Geist Mono --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
        rel="stylesheet">

    {{-- Boxicons icon set (CDN) --}}
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

    {{-- Core application stylesheet --}}
    <link rel="stylesheet" href="/css/style.css">

    {{-- Per-page styles injected via @push('styles') in child views --}}
    @stack('styles')
</head>

<body>

