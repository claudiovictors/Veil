            </button>
        </header>
        {{-- ── END MOBILE HEADER ── --}}

        {{-- ── SIDEBAR ──────────────────────────────────────────────────── --}}
        <aside class="sidebar" id="sidebar">

            {{-- Brand logo link (desktop) --}}
            <a href="{{ route('dashboard.show') }}" class="sidebar-header">
                <svg class="svg-logo" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect class="bg-rect" width="32" height="32" rx="7" />
                    <rect class="fg-rect" x="9" y="9" width="6" height="14" rx="1.5" />
                    <rect class="fg-rect" x="9" y="9" width="14" height="5" rx="1.5" opacity=".45" />
                    <rect class="fg-rect" x="9" y="18" width="14" height="5" rx="1.5" opacity=".45" />
                    <rect class="fg-rect" x="17" y="9" width="6" height="14" rx="1.5" opacity=".7" />
                </svg>
                <span>Slenix Veil</span>
