{{-- ── LOGIN FORM ───────────────────────────────────────────────────────── --}}
{{--
    POST /login → AuthController@login
    Validated by LoginRequest (email + password rules).
--}}
<form action="{{ route('login') }}" method="POST" autocomplete="off">

    {{-- CSRF protection --}}
    @csrf

    {{-- Email ────────────────────────────────────────────────────────────
        @old() repopulates the field after a failed validation attempt.
    --}}
    <div class="form-group">
        <label for="email" class="form-label">Email</label>
        <input
            type="text"
            id="email"
            name="email"
            value="@old('email')"
            placeholder="name@example.com"
            class="form-input @error_class('email', 'form-input--error')"
        />
        @error('email')
            <span class="form-error">{{ $message }}</span>
        @enderror
    </div>

    {{-- Password ─────────────────────────────────────────────────────────
        The eye icon calls togglePasswordVisibility() (defined in guest.luna.php)
        to swap the input between type="password" and type="text".
    --}}
    <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <div class="input-password-wrap">
            <input
                type="password"
                id="password"
                name="password"
                placeholder="••••••••"
                class="form-input @error_class('password', 'form-input--error')"
            />
            <i class="bx bx-show pwd-eye"
               id="password-toggle"
               onclick="togglePasswordVisibility('password', 'password-toggle')">
            </i>
        </div>
        @error('password')
            <span class="form-error">{{ $message }}</span>
        @enderror
    </div>

    {{-- Remember Me ──────────────────────────────────────────────────────
        When checked, the browser sends name="remember" with value "on".
        AuthController@login passes this boolean to auth()->attempt(),
        which issues a long-lived cookie instead of a session-only one.
    --}}
    <div class="checkbox-group">
        <input type="checkbox" id="remember" name="remember" class="checkbox-input">
        <label for="remember" class="checkbox-label">Remember me for 30 days</label>
    </div>

    {{-- ACTIONS ──────────────────────────────────────────────────────────── --}}
    <div class="card-footer">
        <a href="{{ route('register') }}" class="link-sub">Create an account</a>
        <button type="submit" class="btn">Sign in &rarr;</button>
    </div>

</form>

@endsection