    {{-- ── Login Form ───────────────────────────────────────────────────── --}}
    {{--
        POST /sign-in/user → AuthController@login
        The "remember" checkbox value ('on' when checked) is read by the
        controller and passed to auth()->attempt() to issue a persistent cookie.
    --}}
    <form action="{{ route('login') }}" autocomplete="off" method="POST">

        @csrf

        {{-- Email ──────────────────────────────────────────────────────── --}}
        <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                value="@old('email')"
                placeholder="name@example.com"
                required
                autocomplete="email"
            />
        </div>

        {{-- Password (with show/hide toggle) ───────────────────────────── --}}
        <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <input
                type="password"
                id="password"
                name="password"
                class="form-input"
                placeholder="••••••••"
                required
                autocomplete="current-password"
            />
            {{--
                Eye icon — clicking calls togglePasswordVisibility() defined
                in the inline script below.
            --}}
            <i
                class="bx bx-show password-toggle"
                id="password-toggle"
                onclick="togglePasswordVisibility('password', 'password-toggle')"
                title="Show / hide password"
            ></i>
        </div>

        {{--
            Remember Me
            ────────────
            When checked the browser sends name="remember" with value "on".
            AuthController@login reads this and passes the boolean to
            auth()->attempt($credentials, $remember), which tells Slenix
            to issue a long-lived remember cookie instead of a session-only one.
        --}}
        <div class="checkbox-group">
            <input type="checkbox" id="remember" name="remember" class="checkbox-input">
            <label for="remember" class="checkbox-label">Remember me for 30 days</label>
        </div>

        {{-- Actions ─────────────────────────────────────────────────────── --}}
        <div class="card-footer">
            <a href="{{ route('show.register') }}" class="link-sub">Create an account</a>
            <button type="submit" class="btn">Sign in &rarr;</button>
        </div>

    </form>

    {{-- ── Inline Script ────────────────────────────────────────────────── --}}
    <script>
        /**
         * Toggles the visibility of a password input field.
         *
         * Swaps the input type between "password" and "text", and updates
         * the eye icon class to reflect the current state.
         *
         * @param {string} inputId  - The `id` attribute of the password <input>.
         * @param {string} iconId   - The `id` attribute of the Boxicons <i> toggle.
         * @returns {void}
         */
        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon  = document.getElementById(iconId);

            if (!input || !icon) return;

            const isHidden = input.type === 'password';

            input.type    = isHidden ? 'text' : 'password';
            icon.className = isHidden ? 'bx bx-hide password-toggle' : 'bx bx-show password-toggle';
        }
    </script>
