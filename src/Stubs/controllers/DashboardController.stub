<?php

declare(strict_types=1);

namespace App\Controllers;

use Slenix\Http\Request;
use Slenix\Http\Response;

/**
 * DashboardController
 *
 * Handles all authenticated dashboard and settings page rendering.
 * All routes in this controller are protected by the 'auth' middleware.
 *
 * @package App\Controllers
 */
class DashboardController
{
    /**
     * Display the main dashboard page.
     *
     * Renders the primary authenticated landing page shown after login.
     * Future implementations may inject summary statistics, recent activity,
     * or other widgets relevant to the authenticated user.
     *
     * @param  Request  $req  The incoming HTTP request instance.
     * @param  Response $res  The outgoing HTTP response instance.
     * @return mixed          Rendered view for the dashboard.
     */
    public function index(Request $req, Response $res)
    {
        return view('dashboard.index');
    }

    /**
     * Display the user settings page.
     *
     * Renders a tabbed settings interface that allows the authenticated user
     * to manage their profile, change their password, and configure appearance
     * preferences such as the active color theme.
     *
     * @param  Request  $req  The incoming HTTP request instance.
     * @param  Response $res  The outgoing HTTP response instance.
     * @return mixed          Rendered view for the settings page.
     */
    public function settings(Request $req, Response $res)
    {
        return view('dashboard.settings');
    }
}