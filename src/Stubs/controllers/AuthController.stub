<?php

declare(strict_types=1);

namespace App\Controllers;

use App\Models\User;
use Slenix\Http\Request;
use Slenix\Http\Response;
use App\Http\Requests\LoginRequest;
use App\Http\Requests\RegisterRequest;

/**
 * AuthController
 *
 * Handles all authentication-related actions including login,
 * registration, and logout using Slenix's built-in auth system.
 */
class AuthController
{
    /**
     * Display the login page.
     *
     * GET /login
     */
    public function index(Request $req, Response $res)
    {
        return view('auth.login');
    }

    /**
     * Display the registration page.
     *
     * GET /register
     */
    public function create(Request $req, Response $res)
    {
        return view('auth.register');
    }

    /**
     * Handle a login attempt.
     *
     * Validates credentials via LoginRequest and attempts authentication.
     * Redirects to the dashboard on success, or back to login with an
     * error flash message on failure.
     *
     * POST /login
     */
    public function login(LoginRequest $req, Response $res)
    {
        $data = $req->validated();

        if (!auth()->attempt($data)) {
            return redirect()->withFlash('error', 'Invalid credentials.')->to('/login');
        }

        return redirect('/dashboard');
    }

    /**
     * Handle a new user registration.
     *
     * Validates the request via RegisterRequest, creates the user record
     * with a hashed password, and authenticates them immediately.
     * Redirects to the dashboard on success, or back to register on failure.
     *
     * POST /register
     */
    public function store(RegisterRequest $req, Response $res)
    {
        $data = $req->validated();

        $user = User::create([
            'name'     => $data['name'],
            'email'    => $data['email'],
            'password' => password_hash($data['password'], PASSWORD_DEFAULT),
        ]);

        if (!$user) {
            return redirect()->withFlash('error', 'Failed to create account. Please try again.')->to('/register');
        }

        auth()->login($user);

        return redirect('/dashboard')->withFlash('success', 'Account created successfully.');
    }

    /**
     * Log the authenticated user out.
     *
     * Destroys the current session and redirects to the login page
     * with a success flash message.
     *
     * POST /logout
     */
    public function logout(Request $req, Response $res)
    {
        auth()->logout();

        return redirect()->withFlash('success', 'Logout successful.')->to('/login');
    }
}